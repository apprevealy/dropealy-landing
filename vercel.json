{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!(?:api|assets|monitor|admin|login|logout|suporte|termos|privacidade|index|favicon)(?:/|$))[a-z0-9-]{3,60})",
      "destination": "/"
    }
  ]
}
